+/// A Windows notification: a warning icon shows in the tray for a few
+/// seconds and its balloon, which Windows 10 and 11 present as a regular
+/// notification. Runs on a thread of its own, which owns the window behind it.
+#[cfg(windows)]
+pub fn notify(title: &str, text: &str) {
+    use windows_sys::Win32::UI::Shell::{
+        Shell_NotifyIconW, NIF_ICON, NIF_INFO, NIF_TIP, NIIF_WARNING, NIM_ADD, NIM_DELETE, NOTIFYICONDATAW,
+    };
+    use windows_sys::Win32::UI::WindowsAndMessaging::{CreateWindowExW, DestroyWindow, LoadIconW, HWND_MESSAGE, IDI_WARNING};
+
+    fn copy(into: &mut [u16], text: &str) {
+        let wide: Vec<u16> = text.encode_utf16().take(into.len() - 1).collect();
+        into[..wide.len()].copy_from_slice(&wide);
     }
+
+    let (title, text) = (title.to_owned(), text.to_owned());
+    std::thread::spawn(move || {
+        let class: Vec<u16> = "STATIC\0".encode_utf16().collect();
+        // SAFETY: a message-only window of a system class, made, used and
+        // destroyed on this thread; the notify-icon data is a plain C struct
+        // whose all-zero state is empty.
+        unsafe {
+            let hwnd = CreateWindowExW(
+                0,
+                class.as_ptr(),
+                std::ptr::null(),
+                0,
+                0,
+                0,
+                0,
+                0,
+                HWND_MESSAGE,
+                std::ptr::null_mut(),
+                std::ptr::null_mut(),
+                std::ptr::null(),
+            );
+            if hwnd.is_null() {
+                return;
+            }
+            let mut data: NOTIFYICONDATAW = std::mem::zeroed();
+            data.cbSize = std::mem::size_of::<NOTIFYICONDATAW>() as u32;
+            data.hWnd = hwnd;
+            data.uID = 0x5254;
+            data.uFlags = NIF_ICON | NIF_TIP | NIF_INFO;
+            data.hIcon = LoadIconW(std::ptr::null_mut(), IDI_WARNING);
+            data.dwInfoFlags = NIIF_WARNING;
+            copy(&mut data.szTip, &title);
+            copy(&mut data.szInfoTitle, &title);
+            copy(&mut data.szInfo, &text);
+            if Shell_NotifyIconW(NIM_ADD, &data) != 0 {
+                std::thread::sleep(std::time::Duration::from_secs(15));
+                Shell_NotifyIconW(NIM_DELETE, &data);
+            }
+            DestroyWindow(hwnd);
+        }
+    });
 }
+
+#[cfg(not(windows))]
+pub fn notify(_title: &str, _text: &str) {}
