+/// The tray's names for the devices, and the low-battery warning.
+fn tray(app: &mut App, ui: &mut egui::Ui, snap: &Snapshot) {
+    widgets::panel(ui, t("System tray"), |ui| {
+        for device in &snap.devices {
+            let mut changed = false;
+            let name = app.settings.tray_names.entry(device.serial.clone()).or_default();
+            widgets::row(ui, &device.name, t("Its name in the tray. Empty: the device's own name."), |ui| {
+                changed = widgets::text_field(ui, name, &device.name, 200.0).changed();
+            });
+            if changed {
+                app.save_settings();
+            }
+            widgets::divider(ui);
+        }
+        let mut warn = app.settings.low_battery_warning;
+        if widgets::toggle_row(ui, t("Warn when a battery runs low"), t("A Windows notification, once per discharge."), &mut warn) {
+            app.settings.low_battery_warning = warn;
+            app.save_settings();
+        }
+        if app.settings.low_battery_warning {
+            let mut warn_at = f64::from(app.settings.low_battery_warn_at);
+            let mut rearm_at = f64::from(app.settings.low_battery_rearm_at);
+            let mut changed = false;
+            widgets::row(ui, t("Warn at"), t("The charge that brings the warning."), |ui| {
+                changed |= widgets::slider_field(ui, "tray-warn-at", &mut warn_at, 5.0..=50.0, 1.0, 0, "%", 60.0);
+            });
+            widgets::row(ui, t("Warn again after"), t("The charge a device must reach before its next low battery is announced."), |ui| {
+                changed |= widgets::slider_field(ui, "tray-rearm-at", &mut rearm_at, 10.0..=95.0, 1.0, 0, "%", 60.0);
+            });
+            if changed {
+                let warn_at = warn_at.clamp(5.0, 50.0).round() as u8;
+                app.settings.low_battery_warn_at = warn_at;
+                app.settings.low_battery_rearm_at = (rearm_at.clamp(10.0, 95.0).round() as u8).max(warn_at + 5);
+                app.save_settings();
+            }
+        }
+    });
+}
