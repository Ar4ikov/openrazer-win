 4 files changed, 104 insertions(+)

diff --git a/studio/app/src/settings.rs b/studio/app/src/settings.rs
index 879ab19..67f870c 100644
--- a/studio/app/src/settings.rs
+++ b/studio/app/src/settings.rs
@@ -67,6 +67,51 @@ pub struct Settings {
     pub last_battery: BTreeMap<String, LastBattery>,
     /// Devices left out of the tray, by serial (their warnings still come).
     pub tray_hidden: BTreeSet<String>,
+    /// When each device was last charged, by serial.
+    pub charges: BTreeMap<String, Charge>,
+}
+
+/// When a device was last charged: the highest charge it reached and the
+/// day. A charge is seen when the device reports charging, or when a reading
+/// is at least 3 points above the lowest since the last charge (a gauge's
+/// one-point wobble isn't one). A charge to less than full counts; the next
+/// charge replaces the record.
+#[derive(Clone, Debug, Default, PartialEq, Eq, Serialize, Deserialize)]
+#[serde(default)]
+pub struct Charge {
+    /// The highest charge, in percent, of the last charge.
+    pub percent: u8,
+    /// The day of the last charge, `YYYY-MM-DD` local time; empty before the first.
+    pub date: String,
+    low: u8,
+    dropped: bool,
+    seen: bool,
+}
+
+impl Charge {
+    /// Takes a reading; returns whether the record changed.
+    pub fn observe(&mut self, percent: u8, charging: bool, today: &str) -> bool {
+        let before = self.clone();
+        if !self.seen {
+            self.seen = true;
+            self.low = percent;
+            if !charging {
+                return true;
+            }
+        }
+        if charging || percent >= self.low.saturating_add(3) {
+            self.percent = if self.dropped || self.date.is_empty() { percent } else { self.percent.max(percent) };
+            self.dropped = false;
+            self.date = today.to_owned();
+            self.low = percent;
+        } else if percent < self.low {
+            self.low = percent;
+            if !self.date.is_empty() && percent < self.percent {
+                self.dropped = true;
+            }
+        }
+        *self != before
+    }
 }
 
 /// A device's last battery reading, as the tray shows it while it is offline.
@@ -102,6 +147,7 @@ impl Default for Settings {
             low_battery_system_notification: false,
