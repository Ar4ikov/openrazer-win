+    /// Show `lines`, one per device, in the tooltip under the app's name and
+    /// at the top of the menu (greyed: they are for reading).
+    pub fn show_devices(&mut self, lines: &[String]) {
+        use tray_icon::menu::{MenuItem, PredefinedMenuItem};
+
+        let mut tip = String::from(WINDOW_TITLE);
+        for line in lines {
+            tip.push('\n');
+            tip.push_str(line);
+        }
+        let tip: String = tip.chars().take(TOOLTIP_MAX).collect();
+        let _ = self.icon.set_tooltip(Some(tip));
+
+        for row in self.rows.drain(..) {
+            let _ = self.menu.remove(&row);
+        }
+        if let Some(separator) = self.rows_separator.take() {
+            let _ = self.menu.remove(&separator);
+        }
+        for (position, line) in lines.iter().enumerate() {
+            let row = MenuItem::new(line, false, None);
+            if self.menu.insert(&row, position).is_ok() {
+                self.rows.push(row);
+            }
+        }
+        if !self.rows.is_empty() {
+            let separator = PredefinedMenuItem::separator();
+            if self.menu.insert(&separator, self.rows.len()).is_ok() {
+                self.rows_separator = Some(separator);
+            }
+        }
+    }
+}
