 impl App {
     /// Keep the selection pointing at something that exists, and edits current.
+    /// One tray line per device (its tray name and battery), and the
+    /// low-battery notification, once per discharge.
+    fn refresh_tray(&mut self, snap: &Snapshot) {
+        let settings = &self.settings;
+        let mut lines = Vec::with_capacity(snap.devices.len());
+        for device in &snap.devices {
+            let name = settings
+                .tray_names
+                .get(&device.serial)
+                .map(|name| name.trim())
+                .filter(|name| !name.is_empty())
+                .unwrap_or(&device.name)
+                .to_owned();
+            let detail = snap.details.get(&device.serial);
+            let Some(level) = detail.and_then(|d| d.battery) else {
+                lines.push(name);
+                continue;
+            };
+            let charging = detail.and_then(|d| d.charging).unwrap_or(false);
+            let percent = level.clamp(0.0, 100.0).round() as u8;
+            lines.push(if charging {
+                format!("{name}: {percent}% ({})", t("charging"))
+            } else {
+                format!("{name}: {percent}%")
+            });
+
+            if !settings.low_battery_warning || charging || percent >= settings.low_battery_rearm_at {
+                self.tray_warned.remove(&device.serial);
+            } else if percent <= settings.low_battery_warn_at && self.tray_warned.insert(device.serial.clone()) {
+                shell::notify(
+                    &tf("{} battery low", &[&name]),
+                    &tf("{}% left. Charge it soon.", &[&percent]),
+                );
+            }
+        }
+        if lines != self.tray_lines {
+            if let Some(TrayIcon(tray)) = TRAY.lock().unwrap().as_mut() {
+                tray.show_devices(&lines);
+            }
+            self.tray_lines = lines;
+        }
+    }
