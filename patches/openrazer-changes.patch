+/// Where a window of `size` points sits at the bottom centre of the main
+/// display's work area (above the taskbar), for a display at
+/// `pixels_per_point`.
+#[cfg(windows)]
+pub fn popup_position(size: egui::Vec2, pixels_per_point: f32) -> Option<egui::Pos2> {
+    use windows_sys::Win32::Foundation::RECT;
+    use windows_sys::Win32::UI::WindowsAndMessaging::{SystemParametersInfoW, SPI_GETWORKAREA};
+
+    let mut area = RECT { left: 0, top: 0, right: 0, bottom: 0 };
+    // SAFETY: SPI_GETWORKAREA writes one RECT into `area`, which is sized for it.
+    let ok = unsafe { SystemParametersInfoW(SPI_GETWORKAREA, 0, (&raw mut area).cast(), 0) };
+    if ok == 0 || pixels_per_point <= 0.0 {
+        return None;
+    }
+    let scale = |v: i32| v as f32 / pixels_per_point;
+    let centre = (scale(area.left) + scale(area.right)) / 2.0;
+    Some(egui::pos2(centre - size.x / 2.0, scale(area.bottom) - size.y - 48.0))
+}
+
+#[cfg(not(windows))]
+pub fn popup_position(_size: egui::Vec2, _pixels_per_point: f32) -> Option<egui::Pos2> {
+    None
+}
